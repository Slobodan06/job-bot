# Copy this file to backend/.env and fill in real values.
# The app loads backend/.env only — NOT this example file.

# Auth (required)
JWT_SECRET=change-me-to-a-long-random-string

# Site owner — this email gets owner role, full access, and member management
OWNER_EMAIL=you@example.com

# Public app URL (used in activation email links)
APP_URL=http://localhost:5173

# Email activation (Resend) — required for member sign-up magic links
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Vukasin <Vukasin@nivion.tech>

# Optional: defaults to jobbot if omitted from MONGODB_URI
# MONGODB_DB_NAME=jobbot
# MongoDB — set MONGODB_URI or use atlas-credentials.env at repo root
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/jobbot
# JWT_EXPIRE_DAYS=7

# Optional: enables full AI rewrite via OpenAI (otherwise offline keyword + summary mode).
OPENAI_API_KEY=
# Pipeline: v2 = multi-stage (JD analysis → strategy → write → review). legacy = single-call mode.
# OPENAI_PIPELINE=v2
# Fast model for JD analysis (stage 2).
# OPENAI_MODEL_FAST=gpt-4o-mini
# Strong model for strategy, writing, and review (stages 3-5). Default chat-latest for ChatGPT-like writing behavior.
# OPENAI_MODEL_WRITE=chat-latest
# Optional overrides per stage:
# OPENAI_MODEL_STRATEGY=chat-latest
# OPENAI_MODEL_REVIEW=chat-latest
# Fallback if WRITE not set:
# OPENAI_MODEL=gpt-4o-mini
# Tailor runs large prompts with up to 4 LLM calls in v2 — allow enough time.
# OPENAI_TIMEOUT_SECONDS=600
# Minimum accomplishment bullets per employer in generated text (default 2). Word export still capped by template rows.
# OPENAI_MIN_BULLETS_PER_ROLE=2

# Experimental: edit text inside the uploaded PDF instead of using the member's CV template layout.
# USE_PDF_INPLACE=1

# Dev API port (optional). Root `npm run dev` uses scripts/run-backend.mjs; match Vite proxy via same env.
# API_PORT=8010

# Comma-separated browser origins for CORS (dev defaults to Vite URLs if unset).
# CORS_ALLOW_ORIGINS=https://your-domain.com

# Optional: path to built frontend (Docker sets this). Leave unset for API-only / dev.
# FRONTEND_DIST=
