# Copy this file to backend/.env and fill in real values.
# The app loads backend/.env only — NOT this example file.

# Auth (required)
JWT_SECRET=change-me-to-a-long-random-string

# Site owner — this email gets owner role, full access, and member management
OWNER_EMAIL=you@example.com

# Public app URL — used in activation email links and allowed for CORS.
# Local: http://127.0.0.1:8080   Railway: https://job-bot-production-851a.up.railway.app
APP_URL=http://127.0.0.1:8080

# Email activation (Resend) — required for member sign-up magic links
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Vukasin <Vukasin@nivion.tech>

# Optional: defaults to jobbot if omitted from MONGODB_URI
# MONGODB_DB_NAME=jobbot
# MongoDB — set MONGODB_URI or use atlas-credentials.env at repo root
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/jobbot
# JWT_EXPIRE_DAYS=7

# AI provider: "openai" (default) or "deepseek" (much cheaper). Everything that uses AI —
# tailoring, cover letters, application answers, resume parsing — follows this setting.
# AI_PROVIDER=deepseek
#
# DeepSeek (when AI_PROVIDER=deepseek). OPENAI_MODEL_* settings below are ignored then.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat          # optional; default deepseek-chat
# DEEPSEEK_MODEL_WRITE=                 # optional: model for resume/cover-letter/answer writing
# DEEPSEEK_MODEL_FAST=                  # optional: model for parsing/analysis helpers
# DEEPSEEK_BASE_URL=https://api.deepseek.com
#
# Prices used by the AI usage page (USD per 1M tokens: input, output, cached input). Optional.
# OPENAI_PRICING_JSON={"deepseek-chat": [0.28, 0.42, 0.028]}

# OpenAI (when AI_PROVIDER=openai): enables full AI rewrite (otherwise offline keyword + summary mode).
OPENAI_API_KEY=
# Pipeline: v2 = multi-stage (JD analysis → strategy → write → review). legacy = single-call mode.
# OPENAI_PIPELINE=v2
# Fast model for JD analysis (stage 2).
# OPENAI_MODEL_FAST=gpt-4o-mini
# Strong model for strategy, writing, and review (stages 3-5). Default chat-latest for ChatGPT-like writing behavior.
# OPENAI_MODEL_WRITE=chat-latest
# Optional overrides per stage:
# OPENAI_MODEL_STRATEGY=chat-latest
# OPENAI_MODEL_REVIEW=chat-latest
# Fallback if WRITE not set:
# OPENAI_MODEL=gpt-4o-mini
# Tailor runs large prompts with up to 4 LLM calls in v2 — allow enough time.
# OPENAI_TIMEOUT_SECONDS=600
# Minimum accomplishment bullets per employer in generated text (default 2). Word export still capped by template rows.
# OPENAI_MIN_BULLETS_PER_ROLE=2

# Experimental: edit text inside the uploaded PDF instead of using the member's CV template layout.
# USE_PDF_INPLACE=1

# Dev API port (optional). Root `npm run dev` uses scripts/run-backend.mjs; match Vite proxy via same env.
# API_PORT=8010

# Comma-separated browser origins for CORS. Usually unnecessary: the web app is served by
# this same server, APP_URL is always allowed, and the browser extension calls the API from
# its background worker (not subject to CORS). Setting this REPLACES the default list.
# CORS_ALLOW_ORIGINS=https://your-domain.com

# Optional: path to built frontend (Docker sets this). Leave unset for API-only / dev.
# FRONTEND_DIST=

# Job search (Job Search page): free-tier key from https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# RAPIDAPI_KEY=

# Browser extension "Quick fill" / "Tailor & fill" (they use OpenAI credits). Off unless set to 1.
# Job detection and application tracking work either way.
# EXTENSION_AUTOFILL_ENABLED=1
